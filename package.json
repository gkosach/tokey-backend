{
  "name": "sona-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "NODE_ENV=development nodemon -r tsconfig-paths/register src/index.ts",
    "start": "node dist/index.js",
    "format:prettier": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "seed": "ts-node prisma/seed.ts",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "postprisma:generate": "mkdir -p prisma/types && cp -r node_modules/.prisma/client/index.d.ts prisma/types/prismaTypes.d.ts",
    "prestart": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spacylion/sona-backend.git"
  },
  "keywords": [],
  "author": "German Kosach",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Spacylion/sona-backend/issues"
  },
  "homepage": "https://github.com/Spacylion/sona-backend#readme",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.798.0",
    "@aws-sdk/client-s3": "^3.774.0",
    "@aws-sdk/credential-providers": "^3.787.0",
    "@aws-sdk/lib-storage": "^3.774.0",
    "@prisma/client": "^6.6.0",
    "@terraformer/wkt": "^2.2.1",
    "axios": "^1.8.4",
    "body-parser": "^1.20.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.14.1",
    "prisma": "^6.6.0",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.29.1",
    "class-validator-jsonschema": "^5.0.2",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^13.4.19",
    "eslint-config-prettier": "^10.1.2",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-arrow-return-style": "^1.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",

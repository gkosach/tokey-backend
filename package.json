{
  "name": "sona-backend",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "build": "tsc",
    "dev": "npx nodemon",
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "format:prettier": "prettier . --write",
    "db:seed": "ts-node prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:sync": "npm run db:migrate && npm run db:seed",
    "generate": "prisma generate",
    "postgenerate": "npm run --prefix types build",
    "generate:frontend-types": "tsc -p types/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --coverage --runInBand",
    "test:unit": "jest tests/unit --coverage --runInBand",
    "test:integration": "jest --runInBand tests/integration",
    "test:watch": "jest --watch",
    "test:badges": "npm test && node non-bll-scripts/generate-badges.js",
    "test:full": "node non-bll-scripts/test-with-badges.js",
    "generate:badges": "node non-bll-scripts/generate-badges.js",
    "prepare": "husky || true",
    "ngrok": "node non-bll-scripts/start-ngrok.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkosach/sona-backend.git"
  },
  "keywords": [],
  "author": "German Kosach",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gkosach/sona-backend/issues"
  },
  "homepage": "https://github.com/gkosach/sona-backend#readme",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.798.0",
    "@aws-sdk/client-s3": "^3.774.0",
    "@aws-sdk/credential-providers": "^3.787.0",
    "@aws-sdk/lib-storage": "^3.774.0",
    "@aws-sdk/s3-request-presigner": "^3.828.0",
    "@prisma/client": "^6.9.0",
    "@terraformer/wkt": "^2.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.14.1",
    "axios": "^1.8.4",
    "body-parser": "^1.20.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.14.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm-naming-strategies": "^4.1.0",
    "typescript": "^5.8.2",
    "uuid": "^11.1.0",
    "viem": "^2.31.4",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/parse-path": "^7.1.0",

{
  "name": "sona-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch 'src/**/*.ts' --exec ts-node src/index.ts",
    "start": "npm run build && node ./dist/src/index.js",
    "format:prettier": "prettier . --write",
    "format:eslint:fix": "eslint --fix --ext .ts,.tsx .",
    "seed": "ts-node prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "postprisma:generate": "shx cp -r node_modules/.prisma/client/index.d.ts prisma/types/prismaTypes.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spacylion/sona-backend.git"
  },
  "keywords": [],
  "author": "German Kosach",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Spacylion/sona-backend/issues"
  },
  "homepage": "https://github.com/Spacylion/sona-backend#readme",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.774.0",
    "@aws-sdk/lib-storage": "^3.774.0",
    "@prisma/client": "^6.6.0",
    "@terraformer/wkt": "^2.2.1",
    "@types/express": "^5.0.1",
    "axios": "^1.8.4",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.14.1",
    "prisma": "^6.6.0",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^13.4.19",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-arrow-return-style": "^1.3.1",
    "eslint-plugin-prettier": "^5.2.4",
    "eslint-plugin-unused-imports": "^4.1.4",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  }
}

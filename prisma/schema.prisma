generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://dev_user:dev_password@localhost:5432/dev_db"
}

// Типы недвижимости
enum PropertyType {
  Rooms // Комнаты
  Apartment // Квартира
  Villa // Вилла
  Townhouse // Таунхаус
}

// Статусы платежей
enum PaymentStatus {
  Pending // Ожидает
  Paid // Оплачен
  Failed // Неудачный
}

// Методы оплаты
enum PaymentMethod {
  CRYPTO // Криптовалюта
  VISA // банковаская карта
}

enum ApplicationStatus {
  Pending
  Denied
  Approved
}

model Property {
  id               Int          @id @default(autoincrement())
  name             String       @db.VarChar(255)
  description      String       @db.Text
  photoUrls        String[]     @db.Text
  tokenPrice       Float        @default(0)
  totalTokens      Int          @default(1000)
  tokensSold       Int          @default(0)
  rentalPercent    Float        @default(5)
  tokenizationDate DateTime?
  locationId       Int
  managerId        Int?
  propertyType     PropertyType

  location           Location             @relation(fields: [locationId], references: [id])
  manager            Manager?             @relation(fields: [managerId], references: [id])
  tokens             PaymentHistory[]
  Application        Application[]
  investors          Investor[]           @relation("PropertyInvestors")
  favoritedBy        Investor[]           @relation("FavoriteProperties")
  FavoriteProperties FavoriteProperties[]

  @@index([locationId])
  @@index([managerId])
  @@index([tokenizationDate])
}

model FavoriteProperties {
  investor   Investor @relation(fields: [investorId], references: [id])
  investorId Int
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId Int

  @@id([investorId, propertyId])
  @@map("_FavoriteProperties")
}

model Manager {
  id          Int    @id @default(autoincrement())
  cognitoId   String @unique @db.VarChar(255)
  name        String @db.VarChar(100)
  email       String @unique @db.VarChar(255)
  phoneNumber String @unique @db.VarChar(20)

  properties Property[]

  @@index([email])
  @@index([phoneNumber])
}

model Investor {
  id                 Int           @id @default(autoincrement())
  cognitoId          String        @unique @db.VarChar(255)
  name               String        @db.VarChar(100)
  email              String        @unique @db.VarChar(255)
  phoneNumber        String        @unique @db.VarChar(20)
  cryptoWallet       String?       @db.VarChar(42)
  bankAccount        String?       @db.VarChar(34)
  preferredMethod    PaymentMethod @default(CRYPTO)
  investedProperties Property[]    @relation("PropertyInvestors")

  tokens             PaymentHistory[]
  Application        Application[]
  favorites          Property[]           @relation("FavoriteProperties")
  FavoriteProperties FavoriteProperties[]
}

model Application {
  id              Int               @id @default(autoincrement())
  applicationDate DateTime          @default(now())
  status          ApplicationStatus
  message         String?
  propertyId      Int
  investorId      Int

  property Property @relation(fields: [propertyId], references: [id])
  investor Investor @relation(fields: [investorId], references: [id])

  @@index([propertyId])
  @@index([investorId])
}

model PaymentHistory {
  id            Int           @id @default(autoincrement())
  quantity      Int
  purchaseDate  DateTime      @default(now())
  propertyId    Int
  investorId    Int
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(Pending)
  txHash        String?
  amount        Float

  property Property @relation(fields: [propertyId], references: [id])
  investor Investor @relation(fields: [investorId], references: [id])

  @@index([propertyId, investorId])
  @@index([purchaseDate])
}

model Location {
  id        Int        @id @default(autoincrement())
  address   String     @db.VarChar(255)
  latitude  Float
  longitude Float
  Property  Property[]

  @@index([latitude, longitude])
}

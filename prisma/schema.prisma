generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  REJECTED  @map("rejected")
}

enum PropertyStatus {
  COMING_SOON @map("coming_soon")
  ACTIVE      @map("active")
  SOLD_OUT    @map("sold_out")
  COMPLETED   @map("completed")
}

model User {
  id             String    @id @default(uuid())
  cognitoId      String    @unique @map("cognito_id")
  email          String    @unique
  walletAddress  String    @unique @map("wallet_address")
  kycStatus      KycStatus @default(PENDING) @map("kyc_status")
  kycProviderId  String?   @map("kyc_provider_id")
  kycCompletedAt DateTime? @map("kyc_completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  transactions Transaction[]

  @@index([cognitoId], map: "idx_user_cognito")
  @@index([walletAddress], map: "idx_user_wallet")
  @@index([kycStatus], map: "idx_user_kyc_status")
  @@map("users")
}

model Property {
  id              String         @id @default(uuid())
  contractAddress String         @unique @map("contract_address")
  developerId     String         @map("developer_id")
  title           String         @db.VarChar(255)
  district        String         @db.VarChar(10)
  totalTokens     Int            @map("total_tokens")
  availableTokens Int            @map("available_tokens")
  status          PropertyStatus @default(COMING_SOON)
  createdAt       DateTime       @default(now()) @map("created_at")

  description String? @db.Text
  address     String? @db.VarChar(500)
  roi         Float?
  price       Float?
  metadata    Json?

  transactions Transaction[]

  @@index([developerId, district], map: "idx_property_dev_district")
  @@index([status], map: "idx_property_status")
  @@index([availableTokens], map: "idx_property_available")
  @@map("properties")
}

model Transaction {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  propertyId   String   @map("property_id")
  tokensAmount Int      @map("tokens_amount")
  txHash       String   @unique @map("tx_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([userId, propertyId], map: "idx_transaction_user_property")
  @@index([txHash], map: "idx_transaction_hash")
  @@index([createdAt], map: "idx_transaction_created")
  @@map("transactions")
}

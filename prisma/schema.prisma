generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://dev_user:dev_password@localhost:5432/dev_db"
}

enum KYCStatus {
  NotStarted // Не начата
  Pending // На проверке
  Approved // Подтверждён
  Rejected // Отклонён
}

// Типы недвижимости
enum PropertyType {
  Rooms // Комнаты
  Apartment // Квартира
  Villa // Вилла
  Townhouse // Таунхаус
}

// Статусы платежей
enum PaymentStatus {
  Pending // Ожидает
  Paid // Оплачен
  Failed // Неудачный
}

// Методы оплаты
enum PaymentMethod {
  CRYPTO // Криптовалюта
  VISA // банковаская карта
}

enum ModerationStatus {
  Pending // На модерации
  Approved // Одобрено
  Rejected // Отклонено
}

model Property {
  id                Int              @id @default(autoincrement())
  name              String           @db.VarChar(255)
  description       String           @db.Text
  photoUrls         String[]         @db.Text
  tokenPrice        Float            @default(0)
  totalTokens       Int              @default(1000)
  tokensSold        Int              @default(0)
  rentalPercent     Float            @default(5)
  tokenizationDate  DateTime?
  locationId        Int
  managerId         Int?
  propertyType      PropertyType
  moderationStatus  ModerationStatus @default(Pending)
  moderationComment String?

  location           Location             @relation(fields: [locationId], references: [id])
  manager            Manager?             @relation(fields: [managerId], references: [id])
  tokens             PaymentHistory[]
  investors          Investor[]           @relation("PropertyInvestors")
  favoritedBy        Investor[]           @relation("FavoriteProperties")
  FavoriteProperties FavoriteProperties[]

  @@index([locationId])
  @@index([managerId])
  @@index([tokenizationDate])
}

model FavoriteProperties {
  investor   Investor @relation(fields: [investorId], references: [id])
  investorId Int
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId Int

  @@id([investorId, propertyId])
  @@map("_FavoriteProperties")
}

model Manager {
  id             Int       @id @default(autoincrement())
  cognitoId      String    @unique @db.VarChar(255)
  name           String    @db.VarChar(100)
  email          String    @unique @db.VarChar(255)
  phoneNumber    String    @unique @db.VarChar(20)
  kycStatus      KYCStatus @default(NotStarted)
  verificationId String?   @unique

  properties Property[]

  @@index([email])
  @@index([phoneNumber])
}

model Investor {
  id                 Int           @id @default(autoincrement())
  cognitoId          String        @unique @db.VarChar(255)
  name               String        @db.VarChar(100)
  email              String        @unique @db.VarChar(255)
  phoneNumber        String        @unique @db.VarChar(20)
  cryptoWallet       String?       @db.VarChar(42)
  bankAccount        String?       @db.VarChar(34)
  preferredMethod    PaymentMethod @default(CRYPTO)
  investedProperties Property[]    @relation("PropertyInvestors")
  kycStatus          KYCStatus     @default(NotStarted)
  verificationId     String?       @unique

  tokens             PaymentHistory[]
  favorites          Property[]           @relation("FavoriteProperties")
  FavoriteProperties FavoriteProperties[]
}

model PaymentHistory {
  id            Int           @id @default(autoincrement())
  quantity      Int
  purchaseDate  DateTime      @default(now())
  propertyId    Int
  investorId    Int
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(Pending)
  txHash        String?
  amount        Float

  property Property @relation(fields: [propertyId], references: [id])
  investor Investor @relation(fields: [investorId], references: [id])

  @@index([propertyId, investorId])
  @@index([purchaseDate])
}

model Location {
  id        Int        @id @default(autoincrement())
  address   String     @db.VarChar(255)
  latitude  Float
  longitude Float
  Property  Property[]

  @@index([latitude, longitude])
}

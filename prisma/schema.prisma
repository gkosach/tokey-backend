generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "linux-musl-arm64-openssl-3.0.x"]
}

generator typegen {
  provider = "prisma-generator-typescript-interfaces"
  output   = "../types/src/prismaTypes"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  CREATED   @map("inquiry.created")
  COMPLETED @map("inquiry.completed")
  APPROVED  @map("inquiry.approved")
  DECLINED  @map("inquiry.declined")
}

enum PropertyStatus {
  COMING_SOON @map("coming_soon")
  ACTIVE      @map("active")
  SOLD_OUT    @map("sold_out")
  COMPLETED   @map("completed")
}

enum PropertyTierType {
  PLATINUM
  RUBY
  DIAMOND
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  cognitoId      String     @unique @map("cognito_id") @db.VarChar(128)
  email          String     @unique @db.VarChar(255)
  referralLink   String?    @unique @map("referral_link") @db.VarChar(50)
  kycStatus      KycStatus? @map("kyc_status")
  kycProviderId  String?    @map("kyc_provider_id") @db.VarChar(100)
  kycCompletedAt DateTime?  @map("kyc_completed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  transactions TokenTransaction[]

  @@index([kycStatus], map: "idx_user_kyc_status")
  @@index([createdAt], map: "idx_user_created_at")
  @@map("users")
}

model Property {
  id              String         @id @default(uuid()) @db.Uuid
  contractAddress String         @unique @map("contract_address") @db.VarChar(42)
  title           String         @db.VarChar(255)
  status          PropertyStatus @default(COMING_SOON)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  description     String?        @db.Text
  address         String?        @db.VarChar(500)
  media           Json?
  tiers           PropertyTier[]

  @@index([status], map: "idx_property_status")
  @@index([createdAt], map: "idx_property_created_at")
}

model PropertyTier {
  id          String           @id @default(uuid()) @db.Uuid
  propertyId  String           @map("property_id") @db.Uuid
  type        PropertyTierType
  price       Float            @db.Real
  totalSupply Int              @map("total_supply")
  benefits    Json?

  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transactions TokenTransaction[]

  @@index([propertyId], map: "idx_tier_property")
  @@index([type], map: "idx_tier_type")
  @@map("property_tier")
}

model TokenTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  tierId          String   @map("tier_id") @db.Uuid
  tokensAmount    Int      @map("tokens_amount")
  userAddress     String   @map("user_address") @db.VarChar(42)
  contractAddress String   @map("contract_address") @db.VarChar(42)
  txHash          String   @unique @map("tx_hash") @db.VarChar(66)
  paymentAmount   Float    @map("payment_amount") @db.Real
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  tier PropertyTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt], map: "idx_transaction_user_time")
  @@index([tierId, createdAt], map: "idx_transaction_tier_time")
  @@index([createdAt], map: "idx_transaction_created_at")
  @@index([userAddress], map: "idx_transaction_user_address")
  @@map("token_transaction")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://german:prioraKisel124!@postgres-db:5432/sona"
  //  url      = "postgresql://dev_user:dev_password@localhost:5432/dev_db"
}

enum PropertyType {
  Rooms
  Tinyhouse
  Apartment
  Villa
  Townhouse
  Cottage
}

enum ApplicationStatus {
  Pending
  Denied
  Approved
}

enum PaymentStatus {
  Pending
  Paid
  PartiallyPaid
  Overdue
}

model Property {
  id                Int          @id @default(autoincrement())
  name              String
  description       String
  pricePerMonth     Float
  securityDeposit   Float
  applicationFee    Float
  photoUrls         String[]
  isPetsAllowed     Boolean      @default(false)
  isParkingIncluded Boolean      @default(false)
  beds              Int
  baths             Float
  squareFeet        Int
  propertyType      PropertyType
  postedDate        DateTime     @default(now())
  averageRating     Float?       @default(0)
  numberOfReviews   Int?         @default(0)
  locationId        Int
  managerCognitoId  String

  location     Location      @relation(fields: [locationId], references: [id])
  manager      Manager       @relation(fields: [managerCognitoId], references: [cognitoId])
  leases       Lease[]
  applications Application[]
  favoritedBy  Investor[]    @relation("InvestorFavorites")
  investors    Investor[]    @relation("InvestorProperties")
}

model Manager {
  id          Int    @id @default(autoincrement())
  cognitoId   String @unique
  name        String
  email       String
  phoneNumber String

  managedProperties Property[]
}

model Investor {
  id          Int    @id @default(autoincrement())
  cognitoId   String @unique
  name        String
  email       String
  phoneNumber String

  properties   Property[]    @relation("InvestorProperties")
  favorites    Property[]    @relation("InvestorFavorites")
  applications Application[]
  leases       Lease[]
}

model Location {
  id         Int    @id @default(autoincrement())
  address    String
  postalCode String
  latitude   Float
  longitude  Float

  properties Property[]
}

model Application {
  id                Int               @id @default(autoincrement())
  applicationDate   DateTime
  status            ApplicationStatus
  propertyId        Int
  investorCognitoId String
  name              String
  email             String
  phoneNumber       String
  message           String?
  leaseId           Int?              @unique

  property Property @relation(fields: [propertyId], references: [id])
  investor Investor @relation(fields: [investorCognitoId], references: [cognitoId])
  lease    Lease?   @relation(fields: [leaseId], references: [id])
}

model Lease {
  id                Int      @id @default(autoincrement())
  startDate         DateTime
  endDate           DateTime
  rent              Float
  deposit           Float
  propertyId        Int
  investorCognitoId String

  property    Property     @relation(fields: [propertyId], references: [id])
  investor    Investor     @relation(fields: [investorCognitoId], references: [cognitoId])
  application Application?
  payments    Payment[]
}

model Payment {
  id            Int           @id @default(autoincrement())
  amountDue     Float
  amountPaid    Float
  dueDate       DateTime
  paymentDate   DateTime
  paymentStatus PaymentStatus
  leaseId       Int

  lease Lease @relation(fields: [leaseId], references: [id])
}

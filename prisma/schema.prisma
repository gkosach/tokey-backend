generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  CREATED   @map("inquiry.created")
  COMPLETED @map("inquiry.completed")
  APPROVED  @map("inquiry.approved")
  DECLINED  @map("inquiry.declined")
}

enum PropertyStatus {
  COMING_SOON @map("coming_soon")
  ACTIVE      @map("active")
  SOLD_OUT    @map("sold_out")
  COMPLETED   @map("completed")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  cognitoId      String     @unique @map("cognito_id") @db.VarChar(128)
  email          String     @unique @db.VarChar(255)
  referralLink   String?    @unique @map("referral_link") @db.VarChar(50)
  kycStatus      KycStatus? @map("kyc_status")
  kycProviderId  String?    @map("kyc_provider_id") @db.VarChar(100)
  kycCompletedAt DateTime?  @map("kyc_completed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  transactions TokenTransaction[]
  wallet       Wallet?

  @@index([kycStatus], map: "idx_user_kyc_status")
  @@map("users")
}

model Wallet {
  userId        String   @id @map("user_id") @db.Uuid
  tatumWalletId String   @unique @map("tatum_wallet_id") @db.VarChar(100)
  walletAddress String   @unique @map("wallet_address") @db.VarChar(42)
  status        String   @default("active") @map("status") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tatumWalletId], map: "idx_wallet_tatum_id")
  @@index([walletAddress], map: "idx_wallet_wallet_address")
  @@map("wallets")
}

model Property {
  id              String         @id @default(uuid()) @db.Uuid
  contractAddress String         @unique @map("contract_address") @db.VarChar(42)
  developerId     String         @map("developer_id") @db.Uuid
  title           String         @db.VarChar(255)
  district        String         @db.VarChar(20)
  type            String         @db.VarChar(20)
  totalTokens     Int            @map("total_tokens")
  availableTokens Int            @map("available_tokens")
  status          PropertyStatus @default(COMING_SOON)
  price           Float?         @db.Real
  roi             Float?         @db.Real
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  description String? @db.Text
  address     String? @db.VarChar(500)
  metadata    Json?

  transactions TokenTransaction[]

  @@index([status], map: "idx_property_status")
  @@index([status, district], map: "idx_property_status_district")
  @@index([status, price], map: "idx_property_status_price")
  @@map("properties")
}

model TokenTransaction {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @map("user_id") @db.Uuid
  propertyId      String @map("property_id") @db.Uuid
  tokensAmount    Int    @map("tokens_amount")
  txHash          String @unique @map("tx_hash") @db.VarChar(66)
  fromAddress     String @map("from_address") @db.VarChar(42)
  toAddress       String @map("to_address") @db.VarChar(42)
  paymentAmount   Float  @map("payment_amount") @db.Real
  paymentCurrency String @map("payment_currency") @db.VarChar(10)
  transactionType String @map("transaction_type") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt], map: "idx_transaction_user_time")
  @@index([propertyId, createdAt], map: "idx_transaction_property_time")
  @@index([fromAddress], map: "idx_transaction_from")
  @@index([toAddress], map: "idx_transaction_to")
  @@index([transactionType], map: "idx_transaction_type")
  @@map("transactions")
}

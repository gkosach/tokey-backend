#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Checking for schema.prisma changes..."

# Проверяем изменения в schema.prisma
if git diff --name-only HEAD @{u} | grep -q 'prisma/schema.prisma'; then
  echo "🔄 Schema changed - bumping version..."
  # shellcheck disable=SC2164
  cd types
  npm version patch -m "Bump version to %s [skip ci]"
  npm run build
  git add dist package.json package-lock.json
  git commit --amend --no-edit
  cd ..
fi

echo "🧪 Running tests..."
npm run test:unit
